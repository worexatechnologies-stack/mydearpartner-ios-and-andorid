PORT=3000
HOST=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_PORT=5432
# Match POSTGRES_PASSWORD, URL-encoding reserved characters in the URL.
DATABASE_URL=postgresql://mydearpartner_user:replace-with-a-unique-database-password@127.0.0.1:5432/mydearpartner_db

# Keep Gemini credentials server-side. Leave blank to use rule-based comparisons.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Existing authenticated Django API, also used to enforce candidate visibility.
MEMBER_API_BASE_URL=https://mydearpartner.in/api/v1
