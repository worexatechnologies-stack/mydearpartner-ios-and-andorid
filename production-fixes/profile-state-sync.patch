index 642c0dc..f5cea89 100644
--- a/backend/apps/accounts/tests/test_profile_persistence.py
+++ b/backend/apps/accounts/tests/test_profile_persistence.py
@@ -171,3 +171,22 @@ def test_unknown_profile_field_is_rejected_with_400(member, super_admin):
         error_keys = set(errors['detail'].keys())
     # The offending keys must be reported so the client knows they were dropped.
     assert 'not_a_real_field' in error_keys or 'bogus_payload' in error_keys
+
+
+@pytest.mark.parametrize('endpoint', ['/api/v1/auth/me/', '/api/v1/member-auth/me/'])
+def test_state_and_religion_round_trip_and_clear(member, endpoint):
+    client = auth_client(member)
+    values = {'work_location': 'Pune', 'state': 'Maharashtra', 'religion': 'Hindu'}
+    response = client.patch(endpoint, values, format='json')
+    assert response.status_code == 200, response.content
+    profile = MemberProfile.objects.get(member=member)
+    assert profile.state == 'Maharashtra'
+    for key, value in values.items():
+        assert response.data['data'][key] == value
+        assert client.get(endpoint).data['data'][key] == value
+    response = client.patch(endpoint, {'state': '', 'religion': ''}, format='json')
+    assert response.status_code == 200, response.content
+    refreshed = client.get(endpoint).data['data']
+    assert refreshed['state'] == ''
+    assert refreshed['religion'] == ''
+    assert refreshed['work_location'] == 'Pune'
