@@ -0,0 +1,176 @@
+"""Password-bound member login challenges shared by native and browser clients."""
+from datetime import timedelta
+
+from django.contrib.auth.hashers import check_password, make_password
+from django.core import signing
+from django.db import transaction
+from django.utils import timezone
+from django.utils.crypto import salted_hmac
+from rest_framework import permissions, serializers
+from rest_framework.throttling import AnonRateThrottle
+from rest_framework.views import APIView
+
+from apps.core.responses import ApiResponse
+from .models import AccountType, AuthChallenge, Member
+from .mobile import normalize_mobile_number
+from .otp_gateway import OTPChannel, RealtimeOTPDispatcher
+
+SALT = 'accounts.password-login-otp.v1'
+
+
+class LoginOtpThrottle(AnonRateThrottle):
+    rate = '20/min'
+
+
+def _failure(message, status=401):
+    response = ApiResponse(success=False, message=message, status=status)
+    response['Cache-Control'] = 'no-store'
+    return response
+
+
+def _eligible(member):
+    phone = normalize_mobile_number(member.mobile_number)
+    return (member.is_active and member.deleted_at is None
+            and member.account_status == Member.AccountStatus.ACTIVE
+            and member.is_mobile_verified and len(phone) == 10 and phone.isdigit())
+
+
+def _fingerprint(member):
+    value = f'{member.password}:{member.token_version}:{member.mobile_number}:{member.is_mobile_verified}'
+    return salted_hmac(SALT, value, algorithm='sha256').hexdigest()
+
+
+def _response(member, challenge):
+    ticket = signing.dumps({'member': str(member.pk), 'challenge': str(challenge.pk),
+                            'state': _fingerprint(member)}, salt=SALT)
+    response = ApiResponse(data={'requires_otp': True, 'challenge_id': ticket,
+                            'phone_masked': '******' + normalize_mobile_number(member.mobile_number)[-4:]},
+                       message='Verification code sent to your registered mobile number.')
+    response['Cache-Control'] = 'no-store'
+    return response
+
+
+def _resolve(ticket):
+    try:
+        data = signing.loads(ticket, salt=SALT, max_age=300)
+        # UUID parsing prevents malformed signed payloads reaching a UUID query.
+        from uuid import UUID
+        return UUID(data['member']), UUID(data['challenge']), data['state']
+    except (signing.BadSignature, KeyError, TypeError, ValueError):
+        return None
+
+
+def _current(member, challenge, state):
+    return (_eligible(member) and _fingerprint(member) == state and challenge is not None
+            and challenge.consumed_at is None and challenge.expires_at > timezone.now())
+
+
+def _deliver_locked(member, request):
+    from .views import _challenge_code, _client_ip
+    if not _eligible(member):
+        return _failure('A verified registered mobile number is required. Please contact support.', 400)
+    latest = AuthChallenge.objects.filter(account_type=AccountType.MEMBER,
+        identifier=str(member.pk), purpose=AuthChallenge.Purpose.TWO_FACTOR).first()
+    now = timezone.now()
+    if latest and latest.created_at + timedelta(seconds=60) > now:
+        return _failure('Please wait 60 seconds before requesting another code.', 429)
+    code = _challenge_code()
+    # Delivery failure leaves the previous challenge usable.
+    try:
+        delivered = RealtimeOTPDispatcher.send_otp(channel=OTPChannel.SMS,
+            recipient=normalize_mobile_number(member.mobile_number), code=code,
+            purpose=AuthChallenge.Purpose.TWO_FACTOR, request=request)
+    except Exception:
+        delivered = False
+    if not delivered:
+        return _failure('Could not send your verification code. Please try again later.', 503)
+    AuthChallenge.objects.filter(account_type=AccountType.MEMBER, identifier=str(member.pk),
+        purpose=AuthChallenge.Purpose.TWO_FACTOR, consumed_at__isnull=True).update(consumed_at=now)
+    challenge = AuthChallenge.objects.create(account_type=AccountType.MEMBER,
+        identifier=str(member.pk), purpose=AuthChallenge.Purpose.TWO_FACTOR,
+        code_digest=make_password(code), expires_at=now + timedelta(minutes=5),
+        requested_ip=_client_ip(request))
+    return _response(member, challenge)
+
+
+def start_login_otp(member, request):
+    password = member.password
+    with transaction.atomic():
+        member = Member.objects.select_for_update().get(pk=member.pk)
+        if member.password != password:
+            return _failure('Account changed. Please sign in again.')
+        return _deliver_locked(member, request)
+
+
+class LoginOtpInput(serializers.Serializer):
+    challenge_id = serializers.CharField(max_length=2048)
+    otp = serializers.RegexField(r'^[0-9]{6}$', required=False)
+
+
+class MemberLoginOtpVerifyView(APIView):
+    permission_classes = (permissions.AllowAny,)
+    authentication_classes = ()
+    throttle_classes = (LoginOtpThrottle,)
+
+    def post(self, request):
+        serializer = LoginOtpInput(data=request.data)
+        serializer.is_valid(raise_exception=True)
+        if 'otp' not in serializer.validated_data:
+            return _failure('Enter the 6-digit verification code.', 400)
+        resolved = _resolve(serializer.validated_data['challenge_id'])
+        if resolved is None:
+            return _failure('Verification expired. Please sign in again.')
+        member_id, challenge_id, state = resolved
+        with transaction.atomic():
+            member = Member.objects.select_for_update().filter(pk=member_id).first()
+            if member is None:
+                return _failure('Verification expired. Please sign in again.')
+            challenge = AuthChallenge.objects.select_for_update().filter(pk=challenge_id,
+                account_type=AccountType.MEMBER, identifier=str(member.pk),
+                purpose=AuthChallenge.Purpose.TWO_FACTOR).first()
+            if not _current(member, challenge, state):
+                return _failure('Verification expired. Please sign in again.')
+            if challenge.attempts >= challenge.max_attempts:
+                return _failure('Too many incorrect attempts. Please request a new code.')
+            if not check_password(serializer.validated_data['otp'], challenge.code_digest):
+                challenge.attempts += 1
+                challenge.save(update_fields=['attempts'])
+                return _failure('Incorrect verification code. Please try again.')
+            challenge.consumed_at = timezone.now()
+            challenge.save(update_fields=['consumed_at'])
+            from .views import _account_payload, record_login_activity
+            from .models import LoginStatus
+            from .audit import record_security_audit_event
+            from .security import issue_account_tokens, attach_auth_cookies
+            tokens = issue_account_tokens(member, request=request)
+            record_login_activity(account_type=AccountType.MEMBER, account=member,
+                identifier=member.email, login_status=LoginStatus.SUCCESS,
+                request=request, session_id=tokens['session_id'])
+            record_security_audit_event('LOGIN_SUCCESS', request=request, account=member,
+                                       session_id=tokens['session_id'])
+            response = ApiResponse(data={'user': _account_payload(member, request), **tokens},
+                                   message='Login successful.')
+            return attach_auth_cookies(response, tokens['access'], tokens['refresh'], request=request)
+
+
+class MemberLoginOtpResendView(APIView):
+    permission_classes = (permissions.AllowAny,)
+    authentication_classes = ()
+    throttle_classes = (LoginOtpThrottle,)
+
+    def post(self, request):
+        serializer = LoginOtpInput(data=request.data)
+        serializer.is_valid(raise_exception=True)
+        resolved = _resolve(serializer.validated_data['challenge_id'])
+        if resolved is None:
+            return _failure('Verification expired. Please sign in again.')
+        member_id, challenge_id, state = resolved
+        with transaction.atomic():
+            member = Member.objects.select_for_update().filter(pk=member_id).first()
+            if member is None:
+                return _failure('Verification expired. Please sign in again.')
+            challenge = AuthChallenge.objects.filter(pk=challenge_id, account_type=AccountType.MEMBER,
+                identifier=str(member.pk), purpose=AuthChallenge.Purpose.TWO_FACTOR).first()
+            if not _current(member, challenge, state):
+                return _failure('Verification expired. Please sign in again.')
+            return _deliver_locked(member, request)
