+import React from 'react';
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import LoginPage from '@/legacy/pages/LoginPage';
+import { LoginOtpRequiredError } from '@/legacy/contexts/AuthContext';
+
+const mocks = vi.hoisted(() => ({ login: vi.fn(), navigate: vi.fn(), fetchApi: vi.fn() }));
+vi.mock('@/legacy/contexts/AuthContext', async importOriginal => {
+  const actual = await importOriginal<typeof import('@/legacy/contexts/AuthContext')>();
+  return { ...actual, useAuth: () => ({ login: mocks.login, recoverAccount: vi.fn(), isAuthenticated: false, user: null }) };
+});
+vi.mock('@/legacy/services/apiClient', async importOriginal => ({
+  ...await importOriginal<typeof import('@/legacy/services/apiClient')>(), fetchApi: mocks.fetchApi,
+}));
+vi.mock('@/lib/router-compat', () => ({
+  Link: ({ to, children }: { to: string; children: React.ReactNode }) => <a href={to}>{children}</a>,
+  useNavigate: () => mocks.navigate,
+  useSearchParams: () => [{ get: () => null }],
+}));
+beforeEach(() => vi.clearAllMocks());
+afterEach(cleanup);
+
+it('waits for the SMS code before navigating, then submits the opaque challenge', async () => {
+  mocks.login.mockRejectedValueOnce(new LoginOtpRequiredError({ requires_otp: true, challenge_id: 'ticket', phone_masked: '******3210' }));
+  render(<LoginPage />);
+  fireEvent.change(screen.getByLabelText(/Email or Mobile/i), { target: { value: 'member@example.com' } });
+  fireEvent.change(screen.getByLabelText(/^Password$/i), { target: { value: 'password' } });
+  fireEvent.click(screen.getByRole('button', { name: /Continue to verification/i }));
+  expect(await screen.findByLabelText('Verification code')).toBeTruthy();
+  expect(mocks.navigate).not.toHaveBeenCalled();
+  expect(screen.getByRole('button', { name: 'Resend in 60s' })).toBeDisabled();
+  fireEvent.click(screen.getByRole('button', { name: /Verify code and sign in/i }));
+  expect(await screen.findByText('Enter the 6-digit verification code.')).toBeTruthy();
+  expect(mocks.login).toHaveBeenCalledTimes(1);
+  mocks.login.mockResolvedValueOnce({ id: 'member' });
+  fireEvent.change(screen.getByLabelText('Verification code'), { target: { value: '123456' } });
+  fireEvent.click(screen.getByRole('button', { name: /Verify code and sign in/i }));
+  await waitFor(() => expect(mocks.navigate).toHaveBeenCalledWith('/dashboard', { replace: true }));
+  expect(mocks.login).toHaveBeenLastCalledWith('member@example.com', 'password', 'MEMBER', '123456', 'ticket');
+});
+
+it('change account clears the pending challenge', async () => {
+  mocks.login.mockRejectedValueOnce(new LoginOtpRequiredError({ requires_otp: true, challenge_id: 'ticket' }));
+  render(<LoginPage />);
+  fireEvent.change(screen.getByLabelText(/Email or Mobile/i), { target: { value: 'member@example.com' } });
+  fireEvent.change(screen.getByLabelText(/^Password$/i), { target: { value: 'password' } });
+  fireEvent.click(screen.getByRole('button', { name: /Continue to verification/i }));
+  fireEvent.click(await screen.findByRole('button', { name: 'Change account' }));
+  expect(screen.queryByLabelText('Verification code')).toBeNull();
+  expect(screen.getByLabelText(/Email or Mobile/i)).not.toBeDisabled();
+  expect(mocks.navigate).not.toHaveBeenCalled();
+});
