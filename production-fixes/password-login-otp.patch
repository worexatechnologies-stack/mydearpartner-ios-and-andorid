diff --git a/backend/apps/accounts/tests/test_password_login_otp.py b/backend/apps/accounts/tests/test_password_login_otp.py
new file mode 100644
index 0000000..33e5da0
--- /dev/null
+++ b/backend/apps/accounts/tests/test_password_login_otp.py
@@ -0,0 +1,159 @@
+from datetime import timedelta
+from unittest.mock import patch
+
+import pytest
+from django.utils import timezone
+from rest_framework.test import APIClient
+from apps.accounts.models import AuthChallenge, AuthSession, Member
+from apps.conftest import PASSWORD
+
+pytestmark = pytest.mark.django_db
+
+
+def complete_password_login(client, member, identifier=None, password=PASSWORD, **headers):
+    """Exercise both real HTTP steps with only provider delivery mocked."""
+    member.is_mobile_verified = True
+    member.save(update_fields=['is_mobile_verified'])
+    with patch('apps.accounts.otp_gateway.RealtimeOTPDispatcher.send_otp', return_value=True) as send:
+        response = client.post('/api/v1/member-auth/login/', {
+            'identifier': identifier or member.email, 'password': password}, format='json', **headers)
+        assert response.status_code == 200, response.data
+        assert response.data['data']['requires_otp'] is True
+        assert 'access' not in response.data['data']
+        assert not response.cookies
+        return client.post('/api/v1/member-auth/login/verify/', {
+            'challenge_id': response.data['data']['challenge_id'],
+            'otp': send.call_args.kwargs['code']}, format='json', **headers)
+
+
+@pytest.fixture
+def setup(member):
+    from django.core.cache import cache
+    cache.clear()
+    member.is_mobile_verified = True
+    member.save()
+    with patch('apps.accounts.otp_gateway.RealtimeOTPDispatcher.send_otp', return_value=True) as send:
+        yield member, APIClient(HTTP_X_MDP_CLIENT='native'), send
+
+
+def login(member, client, identifier=None):
+    return client.post('/api/v1/auth/login/', {'identifier': identifier or member.email,
+                                             'password': PASSWORD}, format='json')
+
+
+def verify(client, ticket, code):
+    return client.post('/api/v1/auth/login/verify/', {'challenge_id': ticket, 'otp': code}, format='json')
+
+
+def test_password_only_never_creates_session_or_cookies(setup):
+    member, client, send = setup
+    for identifier in [member.email, member.mobile_number, str(member.pk)]:
+        AuthChallenge.objects.all().delete()
+        response = login(member, client, identifier)
+        assert response.status_code == 200
+        assert response.data['data']['requires_otp'] is True
+        assert response.data['data']['challenge_id']
+        assert 'access' not in response.data['data']
+        assert not response.cookies
+        assert response['Cache-Control'] == 'no-store'
+        assert not AuthSession.objects.exists()
+    assert send.call_count == 3
+
+
+def test_valid_code_issues_tokens_once(setup):
+    member, client, send = setup
+    ticket = login(member, client).data['data']['challenge_id']
+    code = send.call_args.kwargs['code']
+    success = verify(client, ticket, code)
+    assert success.status_code == 200
+    assert success.data['data']['access']
+    assert success.data['data']['refresh']
+    assert success.cookies['access_token']['httponly']
+    assert verify(client, ticket, code).status_code == 401
+    assert AuthSession.objects.count() == 1
+
+
+def test_browser_uses_same_challenge_then_httponly_cookies(setup):
+    member, _, send = setup
+    client = APIClient()
+    ticket = login(member, client).data['data']['challenge_id']
+    success = verify(client, ticket, send.call_args.kwargs['code'])
+    assert success.status_code == 200
+    assert 'access' not in success.data['data']
+    assert success.cookies['access_token']['httponly']
+
+
+def test_wrong_password_and_unverified_phone_never_send(setup):
+    member, client, send = setup
+    assert client.post('/api/v1/auth/login/', {'identifier': member.email, 'password': 'wrong'}, format='json').status_code == 401
+    member.is_mobile_verified = False
+    member.save()
+    assert login(member, client).status_code == 400
+    send.assert_not_called()
+    assert not AuthSession.objects.exists()
+
+
+def test_attempt_limit_and_expiry(setup):
+    member, client, send = setup
+    ticket = login(member, client).data['data']['challenge_id']
+    code = send.call_args.kwargs['code']
+    wrong = '000000' if code != '000000' else '111111'
+    for _ in range(5):
+        assert verify(client, ticket, wrong).status_code == 401
+    assert AuthChallenge.objects.get().attempts == 5
+    assert verify(client, ticket, code).status_code == 401
+    AuthChallenge.objects.update(attempts=0, expires_at=timezone.now()-timedelta(seconds=1))
+    assert verify(client, ticket, code).status_code == 401
+    assert not AuthSession.objects.exists()
+
+
+@pytest.mark.parametrize('change', [
+    {'mobile_number': '9876543219'}, {'is_mobile_verified': False}, {'is_active': False},
+    {'account_status': Member.AccountStatus.SUSPENDED}, {'token_version': 5}, {'password': 'changed-hash'},
+])
+def test_changed_account_invalidates_verify_and_resend(setup, change):
+    member, client, send = setup
+    ticket = login(member, client).data['data']['challenge_id']
+    code = send.call_args.kwargs['code']
+    Member.objects.filter(pk=member.pk).update(**change)
+    assert verify(client, ticket, code).status_code == 401
+    assert client.post('/api/v1/auth/login/resend-otp/', {'challenge_id': ticket}, format='json').status_code == 401
+    assert not AuthSession.objects.exists()
+    assert send.call_count == 1
+
+
+def test_resend_cooldown_replacement_and_failure_retains_old_code(setup):
+    member, client, send = setup
+    ticket = login(member, client).data['data']['challenge_id']
+    code = send.call_args.kwargs['code']
+    endpoint = '/api/v1/auth/login/resend-otp/'
+    assert client.post(endpoint, {'challenge_id': ticket}, format='json').status_code == 429
+    AuthChallenge.objects.update(created_at=timezone.now()-timedelta(seconds=61))
+    send.return_value = False
+    assert client.post(endpoint, {'challenge_id': ticket}, format='json').status_code == 503
+    assert AuthChallenge.objects.get().consumed_at is None
+    send.return_value = True
+    response = client.post(endpoint, {'challenge_id': ticket}, format='json')
+    replacement = response.data['data']['challenge_id']
+    assert replacement != ticket
+    assert verify(client, ticket, code).status_code == 401
+    assert verify(client, replacement, send.call_args.kwargs['code']).status_code == 200
+
+
+def test_provider_failure_and_forged_challenge_fail_closed(setup):
+    member, client, send = setup
+    send.return_value = False
+    assert login(member, client).status_code == 503
+    assert not AuthChallenge.objects.exists()
+    assert verify(client, 'forged', '123456').status_code == 401
+    assert not AuthSession.objects.exists()
+
+
+def test_passwordless_routes_cannot_bypass_password_step(setup):
+    member, client, send = setup
+    for endpoint in ['request', 'verify']:
+        response = client.post('/api/v1/auth/otp/'+endpoint+'/', {
+            'identifier': member.mobile_number, 'purpose': 'PASSWORDLESS_LOGIN', 'code': '123456'}, format='json')
+        assert response.status_code == 400
+    send.assert_not_called()
+    assert not AuthSession.objects.exists()
