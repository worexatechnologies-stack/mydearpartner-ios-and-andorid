index 0000000..e3e6538
--- /dev/null
+++ b/backend/apps/matching/saved_searches.py
@@ -0,0 +1,162 @@
+"""Account-owned saved searches and bounded, deduplicated new-member alerts."""
+import hashlib
+import json
+from django.db import transaction
+from django.db.models import Q
+from django.shortcuts import get_object_or_404
+from django.utils import timezone
+from rest_framework import serializers
+from rest_framework.permissions import IsAuthenticated
+from rest_framework.views import APIView
+from rest_framework.response import Response
+from apps.accounts.models import Member, MemberAccountSettings
+from apps.accounts.permissions import IsMember
+from apps.core.eligibility import get_eligible_profiles_for
+from apps.core.models import Notification
+from apps.core.responses import ApiResponse
+from apps.core.api_utils import create_notification
+from .models import SavedSearch, SavedSearchMatch
+
+TEXT_FIELDS = {'query', 'city', 'religion', 'mother_tongue', 'marital_status', 'education', 'profession'}
+LOOKUPS = {'city': 'profile__work_location', 'religion': 'profile__religion',
+           'mother_tongue': 'profile__mother_tongue', 'marital_status': 'profile__marital_status',
+           'education': 'profile__highest_education', 'profession': 'profile__occupation'}
+
+
+class SavedSearchSerializer(serializers.ModelSerializer):
+    class Meta:
+        model = SavedSearch
+        fields = ('id', 'name', 'filters', 'alerts_enabled', 'created_at', 'last_notified_at')
+        read_only_fields = ('id', 'created_at', 'last_notified_at')
+
+    def validate_filters(self, value):
+        if not isinstance(value, dict) or set(value) - (TEXT_FIELDS | {'verified_only'}):
+            raise serializers.ValidationError('Choose supported search filters.')
+        cleaned = {}
+        for key, item in value.items():
+            if key == 'verified_only':
+                if type(item) is not bool:
+                    raise serializers.ValidationError('Verified only must be true or false.')
+                if item:
+                    cleaned[key] = True
+            else:
+                if not isinstance(item, str) or len(item) > 100:
+                    raise serializers.ValidationError('Search values must be text of up to 100 characters.')
+                if item.strip():
+                    cleaned[key] = item.strip()
+        if not cleaned:
+            raise serializers.ValidationError('Choose a filter or enter a search before saving.')
+        return cleaned
+
+
+def matching_profiles(search):
+    qs = get_eligible_profiles_for(search.user)
+    for key, lookup in LOOKUPS.items():
+        value = search.filters.get(key)
+        if value:
+            qs = qs.filter(**{f'{lookup}__icontains': value})
+    query = search.filters.get('query')
+    if query:
+        condition = Q(first_name__icontains=query) | Q(last_name__icontains=query)
+        for lookup in ('profile__work_location', 'profile__state', 'profile__occupation',
+                       'profile__company', 'profile__highest_education', 'profile__religion', 'profile__mother_tongue',
+                       'profile__caste', 'profile__sub_caste', 'profile__gothra', 'profile__about'):
+            condition |= Q(**{f'{lookup}__icontains': query})
+        qs = qs.filter(condition)
+    if search.filters.get('verified_only'):
+        qs = qs.filter(is_mobile_verified=True)
+    return qs
+
+
+class SavedSearchView(APIView):
+    permission_classes = (IsAuthenticated, IsMember)
+
+    def get(self, request, search_id=None):
+        owned = SavedSearch.objects.filter(user=request.user)
+        if search_id:
+            return ApiResponse(data=SavedSearchSerializer(get_object_or_404(owned, pk=search_id)).data)
+        return ApiResponse(data=SavedSearchSerializer(owned, many=True).data)
+
+    @transaction.atomic
+    def post(self, request):
+        Member.objects.select_for_update().get(pk=request.user.pk)
+        serializer = SavedSearchSerializer(data=request.data)
+        serializer.is_valid(raise_exception=True)
+        filters = serializer.validated_data.get('filters')
+        if filters is None:
+            raise serializers.ValidationError({'filters': 'Choose search filters.'})
+        canonical = {key: value.casefold() if isinstance(value, str) else value for key, value in filters.items()}
+        fingerprint = hashlib.sha256(json.dumps(canonical, sort_keys=True).encode()).hexdigest()
+        if SavedSearch.objects.filter(user=request.user, fingerprint=fingerprint).exists():
+            return ApiResponse(message='This search is already saved.', success=False, status=409)
+        if SavedSearch.objects.filter(user=request.user).count() >= 10:
+            raise serializers.ValidationError('You can save up to 10 searches. Delete one before adding another.')
+        saved = serializer.save(user=request.user, fingerprint=fingerprint)
+        return ApiResponse(data=SavedSearchSerializer(saved).data, status=201)
+
+    @transaction.atomic
+    def patch(self, request, search_id):
+        saved = get_object_or_404(SavedSearch.objects.select_for_update(), pk=search_id, user=request.user)
+        if set(request.data) - {'name', 'alerts_enabled'}:
+            raise serializers.ValidationError('Only the name and alert preference can be changed. Save new filters as a new search.')
+        serializer = SavedSearchSerializer(saved, data=request.data, partial=True)
+        serializer.is_valid(raise_exception=True)
+        serializer.save()
+        return ApiResponse(data=serializer.data)
+
+    @transaction.atomic
+    def delete(self, request, search_id):
+        saved = get_object_or_404(SavedSearch.objects.select_for_update(), pk=search_id, user=request.user)
+        Notification.objects.filter(member_recipient=request.user, notification_type='SAVED_SEARCH_MATCH',
+                                    related_object_id=str(saved.pk)).delete()
+        saved.delete()
+        return Response(status=204)
+
+
+class SavedSearchAlertsView(APIView):
+    permission_classes = (IsAuthenticated, IsMember)
+
+    def get(self, request):
+        rows = Notification.objects.filter(member_recipient=request.user, notification_type='SAVED_SEARCH_MATCH').order_by('-created_at')[:50]
+        return ApiResponse(data=[{'id': str(row.pk), 'title': row.title, 'message': row.message,
+                                 'search_id': row.related_object_id, 'created_at': row.created_at,
+                                 'is_read': row.is_read} for row in rows])
+
+    def patch(self, request, alert_id):
+        row = get_object_or_404(Notification, pk=alert_id, member_recipient=request.user, notification_type='SAVED_SEARCH_MATCH')
+        row.is_read = True
+        row.save(update_fields=['is_read'])
+        return Response(status=204)
+
+
+class SavedSearchResultsView(APIView):
+    permission_classes = (IsAuthenticated, IsMember)
+
+    def get(self, request, search_id):
+        from apps.core.api_utils import paginated_response
+        from apps.core.serializers import MemberPublicSerializer
+        saved = get_object_or_404(SavedSearch, pk=search_id, user=request.user)
+        return paginated_response(request, matching_profiles(saved).select_related('profile')
+                                  .order_by('-created_at', 'pk'), MemberPublicSerializer)
+
+
+@transaction.atomic
+def alert_for_saved_search(search_id):
+    search = SavedSearch.objects.select_for_update().select_related('user').filter(pk=search_id, alerts_enabled=True).first()
+    if not search or not search.user.is_active or search.user.deleted_at or search.user.account_status != Member.AccountStatus.ACTIVE:
+        return 0
+    preferences = MemberAccountSettings.objects.filter(member=search.user).first()
+    if preferences and (preferences.notification_preferences or {}).get('matches') is False:
+        return 0
+    candidates = list(matching_profiles(search).filter(created_at__gt=search.created_at)
+                      .exclude(pk__in=SavedSearchMatch.objects.filter(search=search).values('member_id'))
+                      .order_by('created_at', 'pk').values_list('pk', flat=True)[:50])
+    if not candidates:
+        return 0
+    SavedSearchMatch.objects.bulk_create([SavedSearchMatch(search=search, member_id=pk) for pk in candidates])
+    create_notification(search.user, type='SAVED_SEARCH_MATCH', title='New profiles match your saved search',
+                        body='Open your saved search to see new matching profiles.',
+                        link_url=f'/search?saved_search={search.pk}', related_object=search)
+    search.last_notified_at = timezone.now()
+    search.save(update_fields=['last_notified_at'])
+    return len(candidates)
