diff --git a/backend/apps/matching/tests/test_saved_searches.py b/backend/apps/matching/tests/test_saved_searches.py
new file mode 100644
index 0000000..99b8ceb
--- /dev/null
+++ b/backend/apps/matching/tests/test_saved_searches.py
@@ -0,0 +1,181 @@
+from unittest.mock import patch
+import pytest
+from django.utils import timezone
+from rest_framework.test import APIClient
+from apps.accounts.models import Member, MemberProfile, MemberAccountSettings
+from apps.core.models import Notification, ProfileBlock
+from apps.matching.models import SavedSearch, SavedSearchMatch
+from apps.matching.saved_searches import alert_for_saved_search
+from apps.notifications.push import _saved_search_push_allowed
+
+pytestmark = pytest.mark.django_db
+ROOT = '/api/v1/saved-searches/'
+
+
+@pytest.fixture
+def owner(member):
+    member.gender = 'Male'
+    member.save(update_fields=['gender'])
+    return member
+
+
+def client(user):
+    api = APIClient()
+    api.force_authenticate(user)
+    return api
+
+
+def save(owner, **overrides):
+    response = client(owner).post(ROOT, {'name': 'Bengaluru', 'filters': {'city': 'Bengaluru'},
+                                        'alerts_enabled': True, **overrides}, format='json')
+    assert response.status_code == 201, response.data
+    return SavedSearch.objects.get(pk=response.data['data']['id'])
+
+
+def candidate(email='new@example.com', **changes):
+    row = Member.objects.create_user(email=email, password='TestPassword!742', gender='Female',
+                                     is_mobile_verified=True, profile_status=Member.ProfileStatus.APPROVED, **changes)
+    profile, _ = MemberProfile.objects.get_or_create(member=row)
+    profile.work_location = 'Bengaluru'
+    profile.state = 'Karnataka'
+    profile.save()
+    return row
+
+
+def test_saved_searches_are_private_and_persist(owner, other_member):
+    saved = save(owner)
+    assert client(owner).get(ROOT).data['data'][0]['filters'] == {'city': 'Bengaluru'}
+    other = client(other_member)
+    assert other.get(ROOT).data['data'] == []
+    for method in ('get', 'patch', 'delete'):
+        assert getattr(other, method)(f'{ROOT}{saved.pk}/').status_code == 404
+    assert other.get(f'{ROOT}{saved.pk}/results/').status_code == 404
+
+
+def test_validation_duplicate_and_limit_protection(owner):
+    api = client(owner)
+    for filters in ({}, {'city': []}, {'city': 'x' * 101}, {'verified_only': 'true'}, {'user_id': 'other'}):
+        assert api.post(ROOT, {'name': 'Search', 'filters': filters}, format='json').status_code == 400
+    saved = save(owner)
+    assert api.post(ROOT, {'name': 'Duplicate', 'filters': {'city': 'bengaluru'}}, format='json').status_code == 409
+    for index in range(9):
+        save(owner, name=f'Search {index}', filters={'query': f'City {index}'})
+    assert api.post(ROOT, {'name': 'Over limit', 'filters': {'query': 'eleventh'}}, format='json').status_code == 400
+    assert api.patch(f'{ROOT}{saved.pk}/', {'filters': {'city': 'Mumbai'}}, format='json').status_code == 400
+
+
+def test_new_members_only_and_no_repeated_alerts(owner):
+    candidate('existing@example.com')
+    saved = save(owner)
+    assert alert_for_saved_search(saved.pk) == 0
+    new = candidate()
+    assert alert_for_saved_search(saved.pk) == 1
+    assert alert_for_saved_search(saved.pk) == 0
+    assert SavedSearchMatch.objects.get(search=saved).member == new
+    alert = Notification.objects.get(notification_type='SAVED_SEARCH_MATCH')
+    assert alert.member_recipient == owner
+    assert str(saved.pk) in alert.link_url
+    assert new.email not in alert.message
+
+
+def test_hidden_blocked_and_same_gender_profiles_never_alert(owner):
+    saved = save(owner)
+    hidden = candidate('hidden@example.com', is_hidden=True)
+    blocked = candidate('blocked@example.com')
+    ProfileBlock.objects.create(blocker=blocked, blocked=owner)
+    same_gender = candidate('same@example.com')
+    same_gender.gender = 'Male'
+    same_gender.save(update_fields=['gender'])
+    assert alert_for_saved_search(saved.pk) == 0
+    assert client(owner).get(f'{ROOT}{saved.pk}/results/').data['data']['results'] == []
+    hidden.is_hidden = False
+    hidden.save(update_fields=['is_hidden'])
+    assert alert_for_saved_search(saved.pk) == 1
+
+
+def test_later_approval_is_not_missed(owner):
+    saved = save(owner)
+    row = candidate()
+    row.profile_status = Member.ProfileStatus.NOT_STARTED
+    row.save(update_fields=['profile_status'])
+    assert alert_for_saved_search(saved.pk) == 0
+    row.profile_status = Member.ProfileStatus.APPROVED
+    row.save(update_fields=['profile_status'])
+    assert alert_for_saved_search(saved.pk) == 1
+
+
+def test_pause_match_preferences_and_queued_push_preferences(owner):
+    saved = save(owner)
+    candidate()
+    api = client(owner)
+    assert api.patch(f'{ROOT}{saved.pk}/', {'alerts_enabled': False}, format='json').status_code == 200
+    assert alert_for_saved_search(saved.pk) == 0
+    api.patch(f'{ROOT}{saved.pk}/', {'alerts_enabled': True}, format='json')
+    settings, _ = MemberAccountSettings.objects.get_or_create(member=owner)
+    settings.notification_preferences = {'matches': False}
+    settings.save()
+    assert alert_for_saved_search(saved.pk) == 0
+    settings.notification_preferences = {'matches': True}
+    settings.push_notifications = False
+    settings.save()
+    assert alert_for_saved_search(saved.pk) == 1
+    alert = Notification.objects.get(notification_type='SAVED_SEARCH_MATCH')
+    assert _saved_search_push_allowed(alert) is False
+    settings.push_notifications = True
+    settings.save()
+    assert _saved_search_push_allowed(alert) is True
+    api.patch(f'{ROOT}{saved.pk}/', {'alerts_enabled': False}, format='json')
+    assert _saved_search_push_allowed(alert) is False
+
+
+def test_alert_read_and_delete_are_owned(owner, other_member):
+    saved = save(owner)
+    candidate()
+    alert_for_saved_search(saved.pk)
+    alert = client(owner).get(ROOT + 'alerts/').data['data'][0]
+    assert client(other_member).patch(ROOT + f"alerts/{alert['id']}/").status_code == 404
+    assert client(owner).patch(ROOT + f"alerts/{alert['id']}/").status_code == 204
+    assert Notification.objects.get(pk=alert['id']).is_read
+    assert client(owner).delete(f'{ROOT}{saved.pk}/').status_code == 204
+    assert not SavedSearchMatch.objects.exists()
+    assert not Notification.objects.filter(notification_type='SAVED_SEARCH_MATCH').exists()
+
+
+def test_query_and_verified_only_return_real_matches(owner):
+    saved = save(owner, filters={'query': 'Karnataka', 'verified_only': True})
+    row = candidate()
+    response = client(owner).get(f'{ROOT}{saved.pk}/results/')
+    assert response.status_code == 200
+    assert response.data['data']['results'][0]['id'] == str(row.pk)
+    assert alert_for_saved_search(saved.pk) == 1
+
+
+def test_notification_failure_rolls_back_deduplication(owner):
+    saved = save(owner)
+    candidate()
+    with patch('apps.matching.saved_searches.create_notification', side_effect=RuntimeError('database unavailable')):
+        with pytest.raises(RuntimeError):
+            alert_for_saved_search(saved.pk)
+    assert not SavedSearchMatch.objects.exists()
+    assert alert_for_saved_search(saved.pk) == 1
+
+
+def test_login_is_required_and_alerts_default_off(owner):
+    assert APIClient().get(ROOT).status_code in (401, 403)
+    response = client(owner).post(ROOT, {'name': 'Opt-in only', 'filters': {'city': 'Bengaluru'}}, format='json')
+    assert response.status_code == 201
+    assert response.data['data']['alerts_enabled'] is False
+
+
+def test_results_paginate_and_alert_work_is_bounded(owner):
+    saved = save(owner)
+    for index in range(51):
+        candidate(f'bounded-{index}@example.com')
+    response = client(owner).get(f'{ROOT}{saved.pk}/results/?page_size=30')
+    assert response.data['data']['count'] == 51
+    assert len(response.data['data']['results']) == 30
+    assert response.data['data']['next'] == 2
+    assert alert_for_saved_search(saved.pk) == 50
+    assert alert_for_saved_search(saved.pk) == 1
+    assert alert_for_saved_search(saved.pk) == 0
+    assert SavedSearchMatch.objects.filter(search=saved).count() == 51
