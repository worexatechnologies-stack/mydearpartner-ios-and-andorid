diff --git a/frontend/components/member/saved-search-entry.tsx b/frontend/components/member/saved-search-entry.tsx
new file mode 100644
index 0000000..2ba2fa0
--- /dev/null
+++ b/frontend/components/member/saved-search-entry.tsx
@@ -0,0 +1,58 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+import Link from 'next/link';
+import { useSearchParams } from 'next/navigation';
+import { fetchApi } from '@/lib/api-client';
+import { profileHref } from '@/lib/profile-url';
+import SearchPageV2 from './search-page-v2';
+
+type Search = { name: string; alerts_enabled: boolean };
+type Member = { id: string; profile_slug?: string; full_name: string; age?: number };
+type Results = { results: Member[]; next: number | null; previous: number | null };
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+function SavedResults({ id }: { id: string }) {
+  const [search, setSearch] = useState<Search | null>(null);
+  const [results, setResults] = useState<Results | null>(null);
+  const [page, setPage] = useState(1);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    const controller = new AbortController();
+    setResults(null);
+    setError('');
+    if (!UUID.test(id)) { setError('This saved search link is invalid.'); return; }
+    Promise.all([
+      fetchApi<Search>(`/saved-searches/${id}/`, { signal: controller.signal }),
+      fetchApi<Results>(`/saved-searches/${id}/results/`, { params: { page, page_size: 30 }, signal: controller.signal }),
+    ]).then(([saved, matches]) => {
+      if (!controller.signal.aborted) { setSearch(saved); setResults(matches); }
+    }).catch(() => {
+      if (!controller.signal.aborted) setError('This saved search could not be loaded. It may have been deleted.');
+    });
+    return () => controller.abort();
+  }, [id, page]);
+  return <main className="mx-auto max-w-5xl p-6">
+    <Link href="/search" className="text-pink-700 underline">Back to search</Link>
+    <h1 className="my-6 text-2xl font-bold">{search?.name || 'Saved search'}</h1>
+    {error ? <p role="alert">{error}</p> : !results ? <p role="status">Loading matching profiles…</p> : <>
+      {results.results.length === 0 && <p>No matching profiles yet. Check back soon.</p>}
+      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{results.results.map(member =>
+        <Link key={member.id} href={profileHref(member)} className="rounded-xl border p-5 hover:border-pink-500">
+          <h2 className="font-semibold">{member.full_name || 'Member'}</h2>
+          {member.age && <p>{member.age} years</p>}
+          <span className="text-pink-700">View profile</span>
+        </Link>)}</div>
+      <nav aria-label="Saved search pages" className="mt-6 flex gap-4">
+        <button disabled={!results.previous} onClick={() => setPage(results.previous!)}>Previous</button>
+        <span>Page {page}</span>
+        <button disabled={!results.next} onClick={() => setPage(results.next!)}>Next</button>
+      </nav>
+    </>}
+  </main>;
+}
+
+export default function SavedSearchEntry() {
+  const id = useSearchParams().get('saved_search');
+  return id ? <SavedResults key={id} id={id} /> : <SearchPageV2 />;
+}
diff --git a/frontend/tests/saved-search-entry.test.tsx b/frontend/tests/saved-search-entry.test.tsx
new file mode 100644
index 0000000..0883821
--- /dev/null
+++ b/frontend/tests/saved-search-entry.test.tsx
@@ -0,0 +1,36 @@
+import React from 'react';
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import SavedSearchEntry from '@/components/member/saved-search-entry';
+import { fetchApi } from '@/lib/api-client';
+const query = vi.hoisted(() => ({ id: 'aaaa1111-2222-3333-4444-555555555555' as string | null }));
+vi.mock('next/navigation', () => ({ useSearchParams: () => ({ get: () => query.id }) }));
+vi.mock('@/lib/api-client', () => ({ fetchApi: vi.fn() }));
+vi.mock('@/components/member/search-page-v2', () => ({ default: () => <div>Ordinary search</div> }));
+const api = vi.mocked(fetchApi);
+beforeEach(() => { query.id = 'aaaa1111-2222-3333-4444-555555555555'; api.mockReset(); });
+afterEach(cleanup);
+it('opens saved search results and paginates using the server next page', async () => {
+  api.mockImplementation(async endpoint => endpoint.endsWith('/results/')
+    ? { results: [{ id: 'member', profile_slug: 'member-slug', full_name: 'Test Member', age: 25 }], next: 2, previous: null }
+    : { name: 'Nearby', alerts_enabled: true });
+  render(<SavedSearchEntry />);
+  expect(await screen.findByRole('heading', { name: 'Nearby' })).toBeTruthy();
+  expect(screen.getByRole('link', { name: /Test Member/ }).getAttribute('href')).toBe('/profile/member-slug');
+  fireEvent.click(screen.getByRole('button', { name: 'Next' }));
+  await waitFor(() => expect(api).toHaveBeenCalledWith(`/saved-searches/${query.id}/results/`, expect.objectContaining({ params: { page: 2, page_size: 30 } })));
+});
+it('rejects malformed saved-search links without making requests', async () => {
+  query.id = '../other'; render(<SavedSearchEntry />);
+  expect(await screen.findByRole('alert')).toHaveTextContent('invalid');
+  expect(api).not.toHaveBeenCalled();
+});
+it('keeps normal search available without a saved-search parameter', () => {
+  query.id = null; render(<SavedSearchEntry />);
+  expect(screen.getByText('Ordinary search')).toBeTruthy();
+});
+it('shows a recoverable error for a deleted or unavailable search', async () => {
+  api.mockRejectedValue(new Error('Not found')); render(<SavedSearchEntry />);
+  expect(await screen.findByRole('alert')).toHaveTextContent('could not be loaded');
+  expect(screen.getByRole('link', { name: 'Back to search' })).toBeTruthy();
+});
