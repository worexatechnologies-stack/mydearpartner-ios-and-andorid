+def attach_auth_cookies(response, access_token: str, refresh_token: str, *, request=None):
     """Attach Secure, HttpOnly cookies to HTTP response."""
+    # Browsers use HttpOnly cookies. Native clients explicitly request bearer
+    # credentials for secure device storage; apply this contract to every issuer.
+    data = response.data.get('data') if isinstance(getattr(response, 'data', None), dict) else None
+    if isinstance(data, dict):
+        if request is not None and request.headers.get('X-MDP-Client') == 'native':
+            data.update(access=access_token, refresh=refresh_token)
+        else:
+            data.pop('access', None)
+            data.pop('refresh', None)
+    response['Cache-Control'] = 'no-store'
