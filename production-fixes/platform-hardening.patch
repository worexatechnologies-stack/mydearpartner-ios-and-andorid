++// Bound every public AST walker, including callers supplying an AST directly.
++module.exports = ast => {
++  const pending = [[ast, 0]];
++  const seen = new Set();
++  while (pending.length) {
++    const [node, depth] = pending.pop();
++    if (!node || typeof node !== 'object') continue;
++    if (depth > 128 || seen.has(node) || seen.size > 65536) {
++      throw new SyntaxError('Brace pattern exceeds safe nesting limits');
++    }
++    seen.add(node);
++    if (node.nodes) for (const child of node.nodes) pending.push([child, depth + 1]);
++  }
++};
