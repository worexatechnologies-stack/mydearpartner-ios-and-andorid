@@ -0,0 +1,55 @@
+import pytest
+from rest_framework.test import APIClient
+from apps.accounts.models import MemberAccountSettings
+from unittest.mock import patch
+
+pytestmark = pytest.mark.django_db
+
+
+def client_for(member):
+    client = APIClient()
+    client.force_authenticate(member)
+    return client
+
+
+def test_false_string_is_not_treated_as_true(member):
+    response = client_for(member).patch('/api/v1/settings/', {
+        'incognito': 'false', 'push_notifications': 'false', 'email_notifications': False,
+    }, format='json')
+    assert response.status_code == 200
+    member.refresh_from_db()
+    assert member.is_hidden is False
+    saved = MemberAccountSettings.objects.get(member=member)
+    assert saved.push_notifications is False
+    assert saved.email_notifications is False
+
+
+def test_privacy_aliases_persist_and_invalid_changes_are_atomic(member):
+    client = client_for(member)
+    response = client.patch('/api/v1/member-auth/privacy-settings/', {
+        'contact_visibility': 'matches', 'photo_visibility': 'everyone',
+    }, format='json')
+    assert response.status_code == 200
+    assert response.data['data']['contact_visibility'] == 'CONNECTED_ONLY'
+    assert response.data['data']['photo_visibility'] == 'ALL'
+    response = client.patch('/api/v1/settings/', {
+        'incognito': True, 'contact_visibility': 'unsupported',
+    }, format='json')
+    assert response.status_code == 400
+    member.refresh_from_db()
+    assert member.is_hidden is False
+
+
+def test_settings_do_not_leak_between_accounts(member, other_member):
+    client_for(member).patch('/api/v1/settings/', {'push_notifications': False}, format='json')
+    other = client_for(other_member).get('/api/v1/settings/')
+    assert other.status_code == 200
+    assert other.data['data']['push_notifications'] is True
+
+
+@patch('apps.accounts.settings_views.send_event_after_commit')
+def test_privacy_refresh_targets_only_the_changed_member(send_event, member):
+    response = client_for(member).patch('/api/v1/settings/', {'push_notifications': False}, format='json')
+    assert response.status_code == 200
+    assert send_event.call_args.kwargs['groups'] == [f'user_{member.pk}']
+    assert send_event.call_args.kwargs['event_type'] == 'privacy.updated'
