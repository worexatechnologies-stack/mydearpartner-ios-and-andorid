+import pytest
+from rest_framework.test import APIClient
+
+pytestmark = pytest.mark.django_db
+
+
+def test_native_login_gets_tokens_but_browser_login_uses_cookies(member):
+    credentials = {'identifier': member.email, 'password': 'TestPassword!742'}
+    for native in (False, True):
+        client = APIClient()
+        headers = {'HTTP_X_MDP_CLIENT': 'native'} if native else {}
+        response = client.post('/api/v1/member-auth/login/', credentials, format='json', **headers)
+        assert response.status_code == 200
+        data = response.data['data']
+        assert ('access' in data) is native
+        assert ('refresh' in data) is native
+        assert response.cookies['access_token']['httponly']
+        assert response['Cache-Control'] == 'no-store'
+
+
+def test_native_registration_gets_both_tokens():
+    response = APIClient().post('/api/v1/member-auth/register/', {
+        'first_name': 'Maya', 'last_name': 'Member', 'email': 'native-signup@example.com',
+        'mobile_number': '9876543290', 'date_of_birth': '1998-05-15', 'gender': 'Female',
+        'password': 'StrongPassword123!', 'confirm_password': 'StrongPassword123!',
+        'accept_terms': True, 'profile_created_by': 'Self',
+    }, format='json', HTTP_X_MDP_CLIENT='native')
+    assert response.status_code == 201
+    assert response.data['data']['access']
+    assert response.data['data']['refresh']
