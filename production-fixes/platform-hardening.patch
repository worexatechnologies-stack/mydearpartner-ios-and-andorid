diff --git a/frontend/scripts/check-braces.mjs b/frontend/scripts/check-braces.mjs
new file mode 100644
index 0000000..568f6a9
--- /dev/null
+++ b/frontend/scripts/check-braces.mjs
@@ -0,0 +1,13 @@
+import assert from 'node:assert/strict';
+import braces from 'braces';
+assert.deepEqual(braces.expand('a/{b,c}'), ['a/b', 'a/c']);
+assert.throws(() => braces.compile('{'.repeat(2000) + 'a,b' + '}'.repeat(2000)), /safe nesting/);
+let ast = { type: 'text', value: 'leaf' };
+for (let depth = 0; depth < 150; depth++) ast = { type: 'root', nodes: [ast] };
+for (const walker of [braces.compile, braces.expand, braces.stringify]) {
+  assert.throws(() => walker(ast), /safe nesting/);
+  const cycle = { type: 'root', nodes: [] };
+  cycle.nodes.push(cycle);
+  assert.throws(() => walker(cycle), /safe nesting/);
+}
+console.log('braces nesting and cycle regressions passed');
diff --git a/frontend/tests/return-url.test.ts b/frontend/tests/return-url.test.ts
new file mode 100644
index 0000000..787e161
--- /dev/null
+++ b/frontend/tests/return-url.test.ts
@@ -0,0 +1,11 @@
+import { describe, expect, it } from 'vitest';
+import { isValidReturnUrl } from '@/lib/auth';
+
+describe('post-login return URLs', () => {
+  it.each(['https://evil.example/profile', '//evil.example/profile', '/\\evil.example/profile', 'javascript:alert(1)', '/\nevil.example', '/login', '/api/auth/session'])('rejects %s', value => {
+    expect(isValidReturnUrl(value)).toBe(false);
+  });
+  it('accepts a local member route with query parameters', () => {
+    expect(isValidReturnUrl('/profile?tab=photos')).toBe(true);
+  });
+});
