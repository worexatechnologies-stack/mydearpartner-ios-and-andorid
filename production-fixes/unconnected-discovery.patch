index 0000000..d2f7224
--- /dev/null
+++ b/backend/apps/core/tests/test_unconnected_discovery.py
@@ -0,0 +1,31 @@
+import pytest
+from apps.accounts.models import Member, MemberProfile
+from apps.core.models import Interest, ProfileBlock
+from apps.core.services.profile_service import ProfileService
+
+pytestmark = pytest.mark.django_db
+
+
+@pytest.mark.parametrize('status', ['DECLINED', 'WITHDRAWN'])
+@pytest.mark.parametrize('incoming', [False, True])
+def test_ended_relationships_reappear_in_search_and_discover(member, status, incoming):
+    member.gender = 'Male'
+    member.save(update_fields=['gender'])
+    partner = Member.objects.create_user(email=f'{status}-{incoming}@example.com', password='test', gender='Female',
+                                        is_mobile_verified=True, profile_status=Member.ProfileStatus.APPROVED)
+    MemberProfile.objects.get_or_create(member=partner)
+    interest = Interest.objects.create(sender=partner if incoming else member,
+                                      receiver=member if incoming else partner, status=status)
+    for purpose in ('search', 'discover'):
+        assert ProfileService.search_profiles(member, {'purpose': purpose}).filter(pk=partner.pk).exists()
+    interest.status = Interest.Status.PENDING
+    interest.save(update_fields=['status'])
+    assert not ProfileService.search_profiles(member, {'purpose': 'discover'}).filter(pk=partner.pk).exists()
+    interest.status = Interest.Status.ACCEPTED
+    interest.save(update_fields=['status'])
+    assert not ProfileService.search_profiles(member, {'purpose': 'discover'}).filter(pk=partner.pk).exists()
+    interest.status = status
+    interest.save(update_fields=['status'])
+    ProfileBlock.objects.create(blocker=partner, blocked=member)
+    for purpose in ('search', 'discover'):
+        assert not ProfileService.search_profiles(member, {'purpose': purpose}).filter(pk=partner.pk).exists()
