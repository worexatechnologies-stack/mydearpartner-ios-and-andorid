@@ -0,0 +1,15 @@
+import io
+
+import pytest
+from rest_framework.exceptions import ParseError
+from rest_framework.parsers import JSONParser
+
+
+@pytest.mark.parametrize('charset', ['bz2_codec', 'zlib_codec', 'base64_codec', 'hex_codec', 'rot_13'])
+def test_json_parser_rejects_non_text_codecs_before_decoding(charset):
+    with pytest.raises(ParseError, match='Unsupported charset'):
+        JSONParser().parse(io.BytesIO(b'{}'), parser_context={'encoding': charset})
+
+
+def test_json_parser_still_accepts_utf8():
+    assert JSONParser().parse(io.BytesIO(b'{"ok":true}'), parser_context={'encoding': 'utf-8'}) == {'ok': True}
