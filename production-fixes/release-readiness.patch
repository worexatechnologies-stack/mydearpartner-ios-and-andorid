+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+
+BASE_DIR = Path(__file__).resolve().parents[3]
+
+
+def validate_environment(tier, mode, key):
+    # Fully synthetic configuration: no provider requests or database access.
+    env = {
+        'PATH': os.environ.get('PATH', ''),
+        'DJANGO_ENV': tier,
+        'SECRET_KEY': 'audit-only-secret-abcdefghijklmnopqrstuvwxyz-0123456789',
+        'DB_PASSWORD': 'audit-only-password',
+        'DEBUG': 'false',
+        'RENFLAIR_API_KEY': 'local-test-only',
+        'PAYMENT_MODE': 'razorpay',
+        'RAZORPAY_MODE': mode,
+        'RAZORPAY_KEY_ID': key,
+        'RAZORPAY_KEY_SECRET': 'audit-only-provider-secret',
+        'SECURE_PROXY_SSL_HEADER': 'HTTP_X_FORWARDED_PROTO,https',
+        'EMAIL_BACKEND': 'django.core.mail.backends.locmem.EmailBackend',
+        'SUPERADMIN_EMAIL': 'audit-owner@example.test',
+        'SUPERADMIN_PASSWORD': 'audit-only-owner-password',
+        'ENABLE_DEVELOPMENT_SEED': 'false',
+        'ENABLE_DEBUG_TOOLBAR': 'false',
+        'ENABLE_SWAGGER': 'false',
+        'ENABLE_API_DOCS': 'false',
+    }
+    return subprocess.run(
+        [sys.executable, '-c', 'from config.env_validator import config'],
+        cwd=BASE_DIR, env=env, capture_output=True, text=True, timeout=15,
+    )
+
+
+@pytest.mark.parametrize('tier,mode,key', [
+    ('staging', 'test', 'rzp_test_AuditOnly123'),
+    ('production', 'live', 'rzp_live_AuditOnly123'),
+    ('local', 'test', 'rzp_test_AuditOnly123'),
+])
+def test_payment_environment_accepts_only_the_intended_tier(tier, mode, key):
+    result = validate_environment(tier, mode, key)
+    assert result.returncode == 0, result.stderr
+
+
+@pytest.mark.parametrize('tier,mode,key', [
+    ('staging', 'live', 'rzp_live_AuditOnly123'),
+    ('production', 'test', 'rzp_test_AuditOnly123'),
+    ('local', 'live', 'rzp_live_AuditOnly123'),
+    ('staging', 'test', 'rzp_live_AuditOnly123'),
+])
+def test_payment_environment_rejects_cross_tier_keys(tier, mode, key):
+    result = validate_environment(tier, mode, key)
+    assert result.returncode != 0
+    assert 'RAZORPAY_' in result.stderr
+    assert 'audit-only-provider-secret' not in result.stderr
+
+
+def test_invalid_environment_never_falls_back_to_development_defaults():
+    result = validate_environment('prodution', 'test', 'rzp_test_AuditOnly123')
+    assert result.returncode != 0
+    assert 'DJANGO_ENV must be local, staging or production.' in result.stderr
