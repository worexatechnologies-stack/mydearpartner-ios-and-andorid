diff --git a/backend/apps/notifications/tests.py b/backend/apps/notifications/tests.py
index 30dd240..0530010 100644
--- a/backend/apps/notifications/tests.py
+++ b/backend/apps/notifications/tests.py
@@ -649,3 +649,60 @@ class DeviceRegistrationAndPushTests(TestCase):
 
 
 
+    def test_configuration_errors_never_delete_registered_devices(self):
+        from apps.notifications.models import Device
+        from apps.notifications.push import _handle_token_error
+        from firebase_admin import exceptions, messaging
+        device = Device.objects.create(user=self.member1, token='configuration-error-test-token')
+        errors = [exceptions.PermissionDeniedError('MISMATCHED-CREDENTIAL'),
+                  exceptions.NotFoundError('Project resource not found'),
+                  exceptions.InvalidArgumentError('Invalid payload'),
+                  messaging.SenderIdMismatchError('Sender does not match')]
+        for error in errors:
+            with self.subTest(error=type(error).__name__):
+                self.assertFalse(_handle_token_error(device.token, self.member1.pk, error))
+                self.assertTrue(Device.objects.filter(pk=device.pk).exists())
+
+    def test_manual_chat_retry_uses_bounded_exponential_jitter(self):
+        from apps.notifications.push import _chat_retry_countdown
+        with patch('apps.notifications.push.get_exponential_backoff_interval', return_value=12) as backoff:
+            self.assertEqual(_chat_retry_countdown(2), 12)
+            backoff.assert_called_once_with(factor=5, retries=2, maximum=60, full_jitter=True)
+        with patch('apps.notifications.push.get_exponential_backoff_interval', return_value=0):
+            self.assertEqual(_chat_retry_countdown(0), 1)
+
+    def test_transient_task_failure_retries_with_explicit_countdown(self):
+        from celery.exceptions import Retry
+        from firebase_admin import exceptions
+        from apps.notifications.models import Device
+        from apps.notifications.push import deliver_chat_push_task
+        Device.objects.create(user=self.member1, token='transient-test-token')
+        with patch('apps.notifications.push.firebase_app', return_value=object()), \
+             patch('apps.notifications.push.send_chat_push', side_effect=exceptions.UnavailableError('temporary')), \
+             patch('apps.notifications.push._chat_retry_countdown', return_value=7), \
+             patch.object(deliver_chat_push_task, 'retry', side_effect=Retry()) as retry:
+            with self.assertRaises(Retry):
+                deliver_chat_push_task.run(str(self.member1.pk), message_id='retry-message')
+        self.assertEqual(retry.call_args.kwargs['countdown'], 7)
+
+    def test_unavailable_firebase_exhaustion_is_failure(self):
+        from apps.notifications.models import Device
+        from apps.notifications.push import deliver_chat_push_task
+        Device.objects.create(user=self.member1, token='no-firebase-test-token')
+        deliver_chat_push_task.push_request(retries=deliver_chat_push_task.max_retries, called_directly=True)
+        try:
+            with patch('apps.notifications.push.firebase_app', return_value=None):
+                with self.assertRaisesRegex(RuntimeError, 'not initialized'):
+                    deliver_chat_push_task.run(str(self.member1.pk))
+        finally:
+            deliver_chat_push_task.pop_request()
+
+    def test_non_retryable_task_failure_is_not_reported_as_success(self):
+        from firebase_admin import exceptions
+        from apps.notifications.models import Device
+        from apps.notifications.push import deliver_chat_push_task
+        Device.objects.create(user=self.member1, token='invalid-payload-task-token')
+        with patch('apps.notifications.push.firebase_app', return_value=object()), \
+             patch('apps.notifications.push.send_chat_push', side_effect=exceptions.InvalidArgumentError('Invalid payload')):
+            with self.assertRaises(exceptions.InvalidArgumentError):
+                deliver_chat_push_task.run(str(self.member1.pk), message_id='invalid-message')
