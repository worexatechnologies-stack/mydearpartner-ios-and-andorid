DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mydearpartner.in
# The production service requires HTTPS. Enable proxy trust only after configuring
# the trusted reverse proxy to overwrite X-Forwarded-Proto and restricting access.
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600
DJANGO_TRUST_PROXY_HTTPS=false
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Database connection via PgBouncer load balancer & connection pooler (port 6432)
DATABASE_URL=postgresql://mydearpartner:replace-with-a-strong-database-password@pgbouncer:6432/mydearpartner

# Optional: Read-replica database load balancer pool (uncomment to enable horizontal read scaling)
# DATABASE_READ_REPLICA_URL=postgresql://mydearpartner:replace-with-a-strong-database-password@replica-host:6432/mydearpartner
# DATABASE_REPLICAS_URLS=postgresql://mydearpartner:pw@replica1:6432/mydearpartner,postgresql://mydearpartner:pw@replica2:6432/mydearpartner
# DB_LOAD_BALANCER_STRATEGY=round_robin  # 'round_robin' or 'random'
# DB_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me-server-only
RAZORPAY_WEBHOOK_SECRET=replace-me-server-only

# Server-only Google Application Default Credentials for session security pushes.
# Set GOOGLE_APPLICATION_CREDENTIALS to a protected service-account JSON path on the server.
# Never commit that file or bundle it in the mobile app.
SESSION_REPLACED_NOTIFY=account_sessions.push.send_session_notice

# SMS login OTP: configure the approved sender/template and server-only provider key.
# Use SMS_PROVIDER=mock only for local development/tests; it does not deliver SMS.
SMS_PROVIDER=renflair
RENFLAIR_API_KEY=
RENFLAIR_SENDER_ID=MDPTRN
RENFLAIR_DLT_TE_ID=
