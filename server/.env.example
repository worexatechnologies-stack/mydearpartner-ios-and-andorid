DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mydearpartner.in
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://mydearpartner:replace-with-a-strong-database-password@db:5432/mydearpartner
REDIS_URL=redis://redis:6379/0
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me-server-only
RAZORPAY_WEBHOOK_SECRET=replace-me-server-only

# Server-only Google Application Default Credentials for session security pushes.
# Set GOOGLE_APPLICATION_CREDENTIALS to a protected service-account JSON path on the server.
# Never commit that file or bundle it in the mobile app.
SESSION_REPLACED_NOTIFY=account_sessions.push.send_session_notice
