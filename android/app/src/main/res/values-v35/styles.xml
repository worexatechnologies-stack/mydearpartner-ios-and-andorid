<resources>
    <!-- Android 15+ draws the window background behind the system bars.
         Do not request deprecated statusBarColor/navigationBarColor values. -->
    <style name="SplashTheme" parent="SplashThemeBase">
        <item name="android:windowSplashScreenBackground">#FAF8F7</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
